# Contact form (Resend). Domain must be verified in Resend for CONTACT_FROM.
RESEND_API_KEY=
CONTACT_TO=sametbrr@gmail.com
CONTACT_FROM="sametbrr.com · İletişim Formu <iletisim@sametbrr.com>"

# Pato: persistent local disk for pairing rooms and reminders.
# Leave unset to keep phone pairing disabled in production.
PATATES_DB_PATH=
# Set to false to switch reminders off. Keys are optional: without them the server creates
# its own on first start and keeps them in the database.
PATATES_PUSH_ENABLED=
PATATES_VAPID_PUBLIC_KEY=
PATATES_VAPID_PRIVATE_KEY=
PATATES_VAPID_SUBJECT=mailto:sametbrr@gmail.com
